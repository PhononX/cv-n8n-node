{
	"name": "@carbonvoice/n8n-nodes-carbonvoice",
	"version": "0.1.2",
	"publishConfig": {
		"access": "public"
	},
	"description": "Work with Carbon Voice in n8n. Trigger on new messages, voice memos, and more. Send messages, manage conversations, and more.",
	"license": "MIT",
	"homepage": "https://github.com/PhononX/cv-n8n-node#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"carbonvoice",
		"carbon-voice",
		"voice",
		"messaging",
		"voice-memo",
		"webhook",
		"trigger"
	],
	"author": {
		"name": "Carbon Voice",
		"email": "support@carbonvoice.app",
		"url": "https://getcarbon.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PhononX/cv-n8n-node.git"
	},
	"bugs": {
		"url": "https://github.com/PhononX/cv-n8n-node/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CarbonVoiceApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CarbonVoice/CarbonVoice.node.js",
			"dist/nodes/CarbonVoice/CarbonVoiceTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
