# Carbon Voice OAuth app credentials (from https://carbonvoice.app developer portal)
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored.

CARBONVOICE_CLIENT_ID=
CARBONVOICE_CLIENT_SECRET=

# Public URL for webhook delivery during local development.
# Run `ngrok http 5678` and paste the https URL here (no trailing slash).
# When set, run n8n with: WEBHOOK_URL=$WEBHOOK_URL npm run dev
WEBHOOK_URL=
